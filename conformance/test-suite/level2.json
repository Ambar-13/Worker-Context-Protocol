    {
      "id": "L2.1.M_greater_than_N_rejected",
      "level": 2,
      "description": "tasks/post with M > N in attestation_requirement is rejected with -41001.",
      "method": "tasks/post",
      "params_template": {
        "task": {
          "schema_version": "wcp/0.2",
          "task_id": "{{uuid}}",
          "posted_by": "{{agent_did}}",
          "descriptor_type": "transport",
          "descriptor_payload": {},
          "constraints": {
            "worker_class_filter": {
              "allowed": [
                "human"
              ]
            }
          },
          "attestation_requirement": {
            "modes": [
              "sensor-witness"
            ],
            "threshold": "M-of-N",
            "M": 3,
            "N": 2,
            "evidence_schema": [
              {
                "mode": "sensor-witness",
                "kinds": [
                  "gps_track"
                ]
              }
            ]
          },
          "max_attestation_attempts": 1
        },
        "expiry": "2099-12-31T23:59:00Z"
      },
      "expected": {
        "error_code": -41001
      }
    },
    {
