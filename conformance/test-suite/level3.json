{
  "schema_version": "wcp/0.2",
  "level": 3,
  "description": "WCP Level 3 (Federation) test bundle. v0.955 conformance requires Level 1, Level 2, plus all cases here. Settlement-related Level 3 cases removed at v0.955; settlement is no longer a protocol concern.",
  "cases": [
    {
      "id": "L3.1.federation_capability_discovery",
      "level": 3,
      "description": "Federation: an agent on Coordinator A subscribes with filter.federation:true; a worker registered on Coordinator B surfaces via the trust anchor.",
      "method": "capabilities/subscribe",
      "params_template": {
        "agent_did": "{{agent_on_coord_a}}",
        "filter": {
          "federation": true,
          "worker_class": ["autonomous_robot", "human"]
        }
      },
      "expected": {"result_keys": ["subscription_id", "federation_peers_subscribed"]}
    },
    {
      "id": "L3.2.federation_task_post_forwarded",
      "level": 3,
      "description": "Federation: tasks/post on Coordinator A with constraints.federation:true MAY forward to Coordinator B; both audit chains record task_posted entries.",
      "method": "tasks/post",
      "params_template": {
        "task": {
          "schema_version": "wcp/0.2",
          "task_id": "{{uuid}}",
          "posted_by": "{{agent_on_coord_a}}",
          "descriptor_type": "transport",
          "descriptor_payload": {},
          "constraints": {
            "federation": true,
            "worker_class_filter": {"allowed": ["human"]}
          },
          "attestation_requirement": {
            "modes": ["sensor-witness"],
            "threshold": "M-of-N",
            "M": 1,
            "N": 1,
            "evidence_schema": [{"mode": "sensor-witness", "kinds": ["gps_track"]}]
          },
          "max_attestation_attempts": 1
        },
        "expiry": "2099-12-31T23:59:00Z"
      },
      "expected": {"result_keys": ["task_id", "eligible_workers_count", "forwarded_to_peers"]}
    },
    {
      "id": "L3.3.federation_claim_by_peer_worker",
      "level": 3,
      "description": "Federation: a task posted on Coordinator A is claimed by a worker registered on Coordinator B; the claim is recorded on both audit chains.",
      "method": "tasks/claim",
      "params_template": {
        "task_id": "{{task_posted_on_coord_a}}",
        "worker_did": "{{worker_on_coord_b}}",
        "acceptance_attestation": "{{sig}}"
      },
      "expected": {"result_keys": ["claim_id"]}
    },
    {
      "id": "L3.4.federation_audit_chain_export",
      "level": 3,
      "description": "Cross-coordinator audit chain export: a task_completed entry on Coordinator A is fetchable and signature-verifiable from Coordinator B via /wcp/audit/<task_id>.",
      "method": "audit/verify_federated",
      "params_template": {
        "audit_chain_export": "{{audit_chain_from_coord_a}}",
        "verifying_coordinator": "coord-beta",
        "expected_signer_chain_root": "{{coord_a_did}}"
      },
      "expected": {"result_keys": ["chain_verifies", "signer_chain_complete"]}
    },
    {
      "id": "L3.5.federation_reputation_portability",
      "level": 3,
      "description": "Federation: a worker DID's reputation is consistent (within the peer-policy weighting) when queried from either coordinator that shares a trust anchor.",
      "method": "reputation/query",
      "params_template": {
        "worker_did": "{{worker_with_federated_history}}",
        "queried_from_coordinator": "coord-alpha",
        "trust_anchor_with": "coord-beta"
      },
      "expected": {"result_keys": ["reputation", "history_entries", "cross_coordinator_consistency_verified"]}
    },
    {
      "id": "L3.6.cross_coord_robot_as_agent_continuation",
      "level": 3,
      "description": "A RobotAgent on Coordinator A posts a continuation task whose target worker is on Coordinator B. Federation routes the post; continuation_of is preserved on both audit chains; no protocol changes beyond the existing federation primitives.",
      "method": "federation/forward_continuation_post",
      "params_template": {
        "source_coordinator": "coord-alpha",
        "target_coordinator": "coord-beta",
        "agent_class": "embodied_agent",
        "task": {
          "schema_version": "wcp/0.2",
          "task_id": "{{uuid}}",
          "posted_by": "{{robot_agent_did_on_alpha}}",
          "descriptor_type": "place_on_shelf",
          "descriptor_payload": {},
          "continuation_of": {
            "claim_id": "{{prior_claim_id_on_alpha}}",
            "required_evidence_kinds": ["indoor_pose_track"]
          },
          "constraints": {"worker_class_filter": {"allowed": ["semi_autonomous"]}},
          "attestation_requirement": {
            "modes": ["sensor-witness"],
            "threshold": "M-of-N",
            "M": 1,
            "N": 1,
            "evidence_schema": [{"mode": "sensor-witness", "kinds": ["manipulator_pose_track"]}]
          },
          "max_attestation_attempts": 1,
          "supervision": {"default": "autonomous"},
          "x-subcontract-allowed": false
        }
      },
      "expected": {"both_chains_carry_continuation_of": true, "federation_uses_only_existing_rpcs": true}
    },
    {
      "id": "L3.7.cross_coord_agent_class_preserved",
      "level": 3,
      "description": "agent_class declared on the posting agent's credential is preserved across federation forwarding; neither coordinator branches matching on it.",
      "method": "federation/forward_continuation_post",
      "params_template": {
        "source_coordinator": "coord-alpha",
        "target_coordinator": "coord-beta",
        "agent_class": "embodied_agent",
        "task": {
          "schema_version": "wcp/0.2",
          "task_id": "{{uuid}}",
          "posted_by": "{{robot_agent_did_on_alpha}}",
          "descriptor_type": "transport",
          "descriptor_payload": {},
          "constraints": {"worker_class_filter": {"allowed": ["autonomous_robot"]}},
          "attestation_requirement": {
            "modes": ["sensor-witness"],
            "threshold": "M-of-N",
            "M": 1,
            "N": 1,
            "evidence_schema": [{"mode": "sensor-witness", "kinds": ["indoor_pose_track"]}]
          },
          "max_attestation_attempts": 1,
          "supervision": {"default": "autonomous"},
          "x-subcontract-allowed": false
        }
      },
      "expected": {"agent_class_preserved_on_both_chains": "embodied_agent", "no_matching_branch_on_agent_class": true}
    },
    {
      "id": "L3.8.cross_coord_recheck_continuation",
      "level": 3,
      "description": "Cross-coordinator recheck-and-continue: a task voided on Coordinator A is referenced via continuation_of on a new task posted on Coordinator A; the continuation MAY be claimable by a worker on Coordinator B.",
      "method": "tasks/post",
      "params_template": {
        "task": {
          "schema_version": "wcp/0.2",
          "task_id": "{{uuid}}",
          "posted_by": "{{agent_on_coord_a}}",
          "descriptor_type": "transport",
          "descriptor_payload": {},
          "continuation_of": {
            "claim_id": "{{voided_claim_on_coord_a}}",
            "required_evidence_kinds": ["gps_track"]
          },
          "constraints": {
            "federation": true,
            "worker_class_filter": {"allowed": ["human"]}
          },
          "attestation_requirement": {
            "modes": ["sensor-witness"],
            "threshold": "any",
            "M": 1,
            "N": 1,
            "evidence_schema": [{"mode": "sensor-witness", "kinds": ["gps_track"]}]
          },
          "max_attestation_attempts": 2
        },
        "expiry": "2099-12-31T23:59:00Z"
      },
      "expected": {"result_keys": ["task_id", "eligible_workers_count"]}
    },
    {
      "id": "L3.9.federation_jurisdiction_refusal",
      "level": 3,
      "description": "Federation: a peer in a non-compliant jurisdiction per local policy is refused via FEDERATION_JURISDICTION_REFUSED.",
      "method": "capabilities/subscribe",
      "params_template": {
        "agent_did": "{{agent_with_jurisdiction_policy}}",
        "filter": {
          "federation": true,
          "policy_windows": [{"type": "geographic", "scope": "restricted_jurisdiction"}]
        }
      },
      "expected": {"error_code": -50006}
    },
    {
      "id": "L3.10.federation_does_not_relax_local_conformance",
      "level": 3,
      "description": "A federated worker MUST still satisfy the local coordinator's attestation_requirement. Federation does not relax verification.",
      "method": "tasks/attest",
      "params_template": {
        "claim_id": "{{federated_claim_with_local_attestation_required}}",
        "attestations": [{"federated_worker_weak_evidence_placeholder": true}]
      },
      "expected": {"verifier_decision": "fail"}
    }
  ],
  "notes": [
    "v0.955: Level 3 settlement-adapter and cross-coordinator-settlement-clearing cases are removed. Settlement is no longer a protocol concern.",
    "Many Level 3 cases require federation infrastructure not yet implemented in the v0.95 reference coordinator. The two-coordinator federation demo at examples/federation-demo/ is the implementation deliverable that closes these gaps."
  ]
}
