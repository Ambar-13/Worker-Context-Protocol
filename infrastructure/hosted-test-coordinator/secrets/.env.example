# Hosted test coordinator: environment variables.
# Copy this file to secrets/.env and fill in the values for your deployment.
# secrets/.env is gitignored; never commit real values.

# Public DNS hostname this deployment is reachable at. Traefik will obtain
# a Let's Encrypt certificate for this name.
PUBLIC_HOSTNAME=test.example.org

# Email for Let's Encrypt ACME registration. Real email; receives expiry notices.
ACME_EMAIL=ops@example.org

# Coordinator identity. Generate offline with: wcp identity create.
COORDINATOR_DID=did:wcp:test-example-org

# Database
POSTGRES_USER=wcp
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_VALUE
POSTGRES_DB=wcp

# Redis
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_VALUE

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_VALUE
